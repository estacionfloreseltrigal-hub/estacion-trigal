 {
  "id": "tv_fn",
  "type": "function",
  "z": "tab_trigal_v2",
  "name": "Índices instantáneos",
  "func": "const d = msg.payload;\nconst T = d.temperatura;\nconst HR = d.humedad;\n\nif (typeof T === \"number\" && typeof HR === \"number\" && HR > 0 && HR <= 100) {\n    const es = 0.6108 * Math.exp(17.27 * T / (T + 237.3));\n    d.dpv = +(es * (1 - HR / 100)).toFixed(3);\n    const g = Math.log(HR / 100) + 17.27 * T / (237.3 + T);\n    d.punto_rocio = +(237.3 * g / (17.27 - g)).toFixed(2);\n    d.margen_rocio = +(T - d.punto_rocio).toFixed(2);\n}\nreturn msg;",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 380,
  "y": 100,
  "wires": [
   [
    "tv_influx",
    "tv_d_ind"
   ]
  ]
 },
