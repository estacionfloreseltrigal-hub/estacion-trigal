# Copiar como /opt/trigal/app/trigal.env y proteger con: sudo chmod 600 /opt/trigal/app/trigal.env
# Lo leen el puente serial (serial_mqtt.py) y la cámara (main.py).
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=estacion
MQTT_PASS=<clave del usuario estacion de Mosquitto>
ESTACION=estacion1
SERIAL_PORT=
SERIAL_BAUD=115200
HORAS_FOTO=04:00,12:00,20:00
CAM_CLAVE=<clave de la cámara remota (cam.trigal-digital.com/<CAM_CLAVE>/...)>
# Opcionales de la cámara:
# CAM_MQTT_USER=nodered
# CAM_MQTT_PASS=<clave>
# FOTOS_DIR=/home/trigal/fotos
# FOTO_T_EXPO=2.0
